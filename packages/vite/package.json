{
  "name": "fittingroom",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergical/fittingroom.git",
    "directory": "packages/vite"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.mts",
      "import": "./dist/astro.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-ui.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fittingroom/core": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7"
  },
  "devDependencies": {
    "@fittingroom/ui": "workspace:*",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
